{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "packages/dataset/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@graphmd/dataset": ["./packages/dataset/src/index.ts"],
      "@graphmd/persistence": ["./packages/persistence/src/index.ts"],
      "@graphmd/io": ["./packages/io/src/index.ts"],
      "@graphmd/io-zip": ["./packages/io-zip/src/index.ts"],
      "@graphmd/io-vcs": ["./packages/io-vcs/src/index.ts"],
      "@graphmd/io-github": ["./packages/io-github/src/index.ts"],
      "@graphmd/runtime": ["./packages/runtime/src/index.ts"],
      "@graphmd/app-kit": ["./packages/app-kit/src/index.ts"],
      "@graphmd/storage-idb": ["./packages/storage-idb/src/index.ts"]
    }
  },
  "include": ["packages/dataset/src/**/*.ts"],
  "exclude": [
    "packages/dataset/src/**/__tests__/**",
    "packages/dataset/src/**/__fixtures__/**",
    "packages/dataset/src/**/*.test.ts",
    "packages/dataset/src/**/*.spec.ts",
    "packages/dataset/src/**/*.test.tsx",
    "packages/dataset/src/**/*.spec.tsx"
  ]
}
