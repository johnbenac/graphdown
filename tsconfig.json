{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "apps/web/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["apps/web/src/graphdown/**/*.ts"],
  "exclude": [
    "apps/web/src/graphdown/**/__tests__/**",
    "apps/web/src/graphdown/**/__fixtures__/**",
    "apps/web/src/graphdown/**/*.test.ts",
    "apps/web/src/graphdown/**/*.spec.ts",
    "apps/web/src/graphdown/**/*.test.tsx",
    "apps/web/src/graphdown/**/*.spec.tsx"
  ]
}
