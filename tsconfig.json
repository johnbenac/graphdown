{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["packages/core/src/**/*.ts"],
  "exclude": [
    "packages/core/src/**/__tests__/**",
    "packages/core/src/**/__fixtures__/**",
    "packages/core/src/**/*.test.ts",
    "packages/core/src/**/*.spec.ts"
  ]
}
