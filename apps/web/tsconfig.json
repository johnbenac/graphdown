{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@graphmd/app-kit": ["../../packages/app-kit/src/index.ts"],
      "@graphmd/dataset": ["../../packages/dataset/src/index.ts"],
      "@graphmd/io": ["../../packages/io/src/index.ts"],
      "@graphmd/io-github": ["../../packages/io-github/src/index.ts"],
      "@graphmd/io-zip": ["../../packages/io-zip/src/index.ts"],
      "@graphmd/runtime": ["../../packages/runtime/src/index.ts"],
      "@graphmd/storage-idb": ["../../packages/storage-idb/src/index.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "e2e"]
}
